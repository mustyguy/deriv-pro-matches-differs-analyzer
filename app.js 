/* ==========================================
   ANALYSIS PROGRESS
   UNDER 5 SECONDS
========================================== */

function startAnalysis() {

  if (
    tickData.length < 50
  ) {

    progressFill.style.width =
      "0%";


    progressText.textContent =
      `NEED MORE DATA: ${tickData.length}/50 TICKS`;

    return;

  }


  analyzeButton.disabled =
    true;


  let progress = 0;


  progressFill.style.width =
    "0%";


  progressText.textContent =
    "ANALYZING REAL LIVE DATA... 0%";


  const timer =
    setInterval(() => {

      progress += 2;


      if (progress > 100) {

        progress = 100;

      }


      progressFill.style.width =
        progress + "%";


      progressText.textContent =
        `ANALYZING REAL LIVE DATA... ${progress}%`;


      if (progress >= 100) {

        clearInterval(timer);


        runStatisticalAnalysis();


        progressText.textContent =
          "ANALYSIS COMPLETE ✓";


        analyzeButton.disabled =
          false;

      }

    }, 45);

}


/* ==========================================
   GET WINDOW
========================================== */

function getWindow(size) {

  return tickData.slice(-size);

}


/* ==========================================
   FREQUENCY OF A DIGIT
========================================== */

function frequency(digit, size) {

  const window =
    getWindow(size);


  if (
    window.length === 0
  ) {

    return 0;

  }


  const count =
    window.filter(
      item =>
        item.digit === digit
    ).length;


  return count /
    window.length;

}


/* ==========================================
   RAW COUNT IN WINDOW
========================================== */

function windowCount(
  digit,
  size
) {

  const window =
    getWindow(size);


  return window.filter(
    item =>
      item.digit === digit
  ).length;

}


/* ==========================================
   TRANSITION PROBABILITY

   Example:

   If latest digit is 7,
   this checks historically what digit
   followed 7.
========================================== */

function transitionProbability(
  targetDigit
) {

  if (
    tickData.length < 20
  ) {

    return 0;

  }


  const previousDigit =
    tickData[
      tickData.length - 1
    ].digit;


  let previousCount = 0;

  let targetCount = 0;


  for (
    let i = 0;

    i <
    tickData.length - 1;

    i++
  ) {

    if (
      tickData[i].digit ===
      previousDigit
    ) {

      previousCount++;


      if (
        tickData[i + 1].digit ===
        targetDigit
      ) {

        targetCount++;

      }

    }

  }


  if (
    previousCount === 0
  ) {

    return 0;

  }


  return (
    targetCount /
    previousCount
  );

}


/* ==========================================
   RECENCY SCORE

   Gives more weight to appearances
   closer to the latest tick.
========================================== */

function recencyScore(digit) {

  const window =
    tickData.slice(-50);


  if (
    window.length === 0
  ) {

    return 0;

  }


  let score = 0;

  let maxScore = 0;


  window.forEach(
    (item, index) => {

      const weight =
        index + 1;


      maxScore +=
        weight;


      if (
        item.digit === digit
      ) {

        score +=
          weight;

      }

    }
  );


  return score / maxScore;

}


/* ==========================================
   APPEARANCES IN FULL DATASET
========================================== */

function appearances(digit) {

  return tickData.filter(
    item =>
      item.digit === digit
  ).length;

}


/* ==========================================
   ANALYZE ONE DIGIT
========================================== */

function analyzeDigit(digit) {

  const count10 =
    windowCount(digit, 10);


  const count20 =
    windowCount(digit, 20);


  const count50 =
    windowCount(digit, 50);


  const f10 =
    frequency(digit, 10);


  const f20 =
    frequency(digit, 20);


  const f50 =
    frequency(digit, 50);


  const f100 =
    frequency(digit, 100);


  const f250 =
    frequency(digit, 250);


  const f500 =
    frequency(digit, 500);


  const transition =
    transitionProbability(
      digit
    );


  const recent =
    recencyScore(
      digit
    );


  const totalAppearances =
    appearances(
      digit
    );


  /*
     MULTI-WINDOW FREQUENCY

     Recent windows receive
     higher importance.
  */

  const averageFrequency =
    (
      f10 * 0.30 +
      f20 * 0.20 +
      f50 * 0.20 +
      f100 * 0.15 +
      f250 * 0.10 +
      f500 * 0.05
    );


  /*
     MATCH SCORE

     Priorities:

     1. Recent frequency
     2. Recent appearances
     3. Transition behavior
     4. Recency weighting

     NO RANDOM SELECTION.
  */

  const matchScore =
    (
      averageFrequency * 0.45
    ) +

    (
      transition * 0.25
    ) +

    (
      recent * 0.20
    ) +

    (
      Math.min(
        count10 / 4,
        1
      ) * 0.10
    );


  /*
     DIFFERS SCORE

     A stronger candidate is a digit
     with relatively LOW observed
     frequency and LOW transition
     probability.

     Long drought is NOT treated as
     proof that a digit will continue
     avoiding, because that would create
     a gambler's-fallacy assumption.
  */

  const differsScore =
    (
      (1 - Math.min(
        f10 * 10,
        1
      )) * 0.30
    ) +

    (
      (1 - Math.min(
        f20 * 10,
        1
      )) * 0.20
    ) +

    (
      (1 - Math.min(
        f50 * 10,
        1
      )) * 0.20
    ) +

    (
      (1 - Math.min(
        transition * 10,
        1
      )) * 0.20
    ) +

    (
      (1 - Math.min(
        recent * 10,
        1
      )) * 0.10
    );


  return {

    digit,

    count10,

    count20,

    count50,

    f10,

    f20,

    f50,

    f100,

    f250,

    f500,

    transition,

    recent,

    appearances:
      totalAppearances,

    matchScore,

    differsScore

  };

}


/* ==========================================
   MAIN ANALYSIS ENGINE
========================================== */

function runStatisticalAnalysis() {

  const results = [];


  for (
    let digit = 0;

    digit <= 9;

    digit++
  ) {

    results.push(
      analyzeDigit(digit)
    );

  }


  /*
     MATCHES SELECTION

     YOUR PREFERENCE:

     Give priority to digits that
     appeared repeatedly in the
     most recent ticks.

     Priority 1:
     Appeared 3 or more times
     in the latest 10 ticks.

     Priority 2:
     Appeared 2 or more times
     in latest 10 ticks.

     Priority 3:
     Best statistical candidate.
  */

  let matchesCandidates =
    results.filter(
      item =>
        item.count10 >= 3
    );


  if (
    matchesCandidates.length === 0
  ) {

    matchesCandidates =
      results.filter(
        item =>
          item.count10 >= 2
      );

  }


  if (
    matchesCandidates.length === 0
  ) {

    matchesCandidates =
      results;

  }


  const matches =
    [...matchesCandidates]
      .sort(
        (a, b) => {

          if (
            b.matchScore !==
            a.matchScore
          ) {

            return (
              b.matchScore -
              a.matchScore
            );

          }


          return (
            b.count10 -
            a.count10
          );

        }
      )[0];


  /*
     DIFFERS SELECTION

     Choose strongest avoidance
     candidate from observed data.

     We prevent the exact Matches
     digit from automatically being
     used for Differs unless all
     other data is tied.
  */

  let differsCandidates =
    results.filter(
      item =>
        item.digit !==
        matches.digit
    );


  if (
    differsCandidates.length === 0
  ) {

    differsCandidates =
      results;

  }


  const differs =
    [...differsCandidates]
      .sort(
        (a, b) => {

          if (
            b.differsScore !==
            a.differsScore
          ) {

            return (
              b.differsScore -
              a.differsScore
            );

          }


          return (
            a.count10 -
            b.count10
          );

        }
      )[0];


  displayMatches(
    matches
  );


  displayDiffers(
    differs
  );

}


