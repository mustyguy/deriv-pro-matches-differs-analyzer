  startAnalysis
);


/* =========================================================
   ANALYSIS PROGRESS

   1% to 100% in under 5 seconds.
========================================================= */

function startAnalysis() {

  if (
    tickData.length < 50
  ) {

    progressText.textContent =
      `NEED MORE DATA: ${tickData.length}/50 TICKS`;

    return;

  }


  analyzeButton.disabled =
    true;


  let progress = 0;


  progressFill.style.width =
    "0%";


  const timer =
    setInterval(() => {

      progress++;


      progressFill.style.width =
        progress + "%";


      progressText.textContent =
        `ANALYZING LIVE DATA... ${progress}%`;


      if (
        progress >= 100
      ) {

        clearInterval(
          timer
        );


        runStatisticalAnalysis();


        progressText.textContent =
          "ANALYSIS COMPLETE ✓";


        analyzeButton.disabled =
          false;

      }

    }, 40);

}


/* =========================================================
   FREQUENCY IN WINDOW
========================================================= */

function frequency(
  digit,
  size
) {

  const window =
    tickData.slice(-size);


  if (!window.length) {

    return 0;

  }


  const count =
    window.filter(
      item =>
        item.digit === digit
    ).length;


  return count /
    window.length;

}


/* =========================================================
   TRANSITION PROBABILITY

   Based on the CURRENT last digit.

   Example:
   If current digit is 7,
   calculate historically how often
   7 was followed by target digit.
========================================================= */

function transitionProbability(
  targetDigit
) {

  if (
    tickData.length < 20
  ) {

    return 0.1;

  }


  const previousDigit =
    tickData[
      tickData.length - 1
    ].digit;


  let previousCount = 0;

  let targetCount = 0;


  for (
    let i = 0;
    i < tickData.length - 1;
    i++
  ) {

    if (
      tickData[i].digit ===
      previousDigit
    ) {

      previousCount++;


      if (
        tickData[i + 1].digit ===
        targetDigit
      ) {

        targetCount++;

      }

    }

  }


  /*
    Laplace smoothing.
    Prevents false 0% or 100%
    from tiny samples.
  */

  return (
    targetCount + 1
  ) /
  (
    previousCount + 10
  );

}


/* =========================================================
   DROUGHT
========================================================= */

function drought(digit) {

  let count = 0;


  for (
    let i =
      tickData.length - 1;

    i >= 0;

    i--
  ) {

    if (
      tickData[i].digit ===
      digit
    ) {

      break;

    }


    count++;

  }


  return count;

}


/* =========================================================
   TOTAL APPEARANCES
========================================================= */

function appearances(digit) {

  return tickData.filter(
    item =>
      item.digit === digit
  ).length;

}


/* =========================================================
   RECENT MOMENTUM

   Compares recent 50 ticks against
   a longer window.
========================================================= */

function recentMomentum(
  digit
) {

  const recent =
    frequency(digit, 50);


  const longer =
    frequency(digit, 300);


  return (
    recent -
    longer
  );

}


/* =========================================================
   NEXT-10 HISTORICAL REPEAT TEST

   Your requested concept:

   When a digit appeared historically,
   examine the NEXT 10 ticks.

   Calculate how often that digit
   appeared at least 3 times in those
   following 10 ticks.

   This is a historical statistic,
   NOT a guarantee of future ticks.
========================================================= */

function nextTenRepeatRate(
  digit
) {

  let samples = 0;

  let successful = 0;


  const start =
    Math.max(
      0,
      tickData.length - 500
    );


  for (
    let i = start;
    i < tickData.length - 10;
    i++
  ) {

    if (
      tickData[i].digit !== digit
    ) {

      continue;

    }


    samples++;


    let repeatCount = 0;


    for (
      let j = i + 1;
      j <= i + 10;
      j++
    ) {

      if (
        tickData[j].digit === digit
      ) {

        repeatCount++;

      }

    }


    /*
      Your 3–4 appearances concept:
      count 3 or more appearances.
    */

    if (
      repeatCount >= 3
    ) {

      successful++;

    }

  }


  /*
    Smoothed rate.
  */

  if (
    samples < 5
  ) {

    return 0;

  }


  return (
    successful + 1
  ) /
  (
    samples + 2
  );

}


/* =========================================================
   NEXT-10 AVOIDANCE RATE

   For DIFFERS:

   How often was this digit absent
   from the following 10 ticks after
   historical observations?
========================================================= */

function nextTenAvoidanceRate(
  digit
) {

  let samples = 0;

  let avoided = 0;


  const start =
    Math.max(
      0,
      tickData.length - 500
    );


  for (
    let i = start;
    i < tickData.length - 10;
    i++
  ) {

    samples++;


    let appeared =
      false;


    for (
      let j = i + 1;
      j <= i + 10;
      j++
    ) {

      if (
        tickData[j].digit === digit
      ) {

        appeared =
          true;

        break;

      }

    }


    if (!appeared) {

      avoided++;

    }

  }


  if (
    samples < 10
  ) {

    return 0;

  }


  return (
    avoided + 1
  ) /
  (
    samples + 2
  );

}


/* =========================================================
   ANALYZE ONE DIGIT
========================================================= */

function analyzeDigit(
  digit
) {

  const f50 =
    frequency(digit, 50);


  const f100 =
    frequency(digit, 100);


  const f250 =
    frequency(digit, 250);


  const f500 =
    frequency(digit, 500);


  const transition =
    transitionProbability(
      digit
    );


  const droughtValue =
    drought(digit);


  const totalAppearances =
    appearances(digit);


  const momentum =
    recentMomentum(
      digit
    );


  const repeatRate =
    nextTenRepeatRate(
      digit
    );


  const avoidanceRate =
    nextTenAvoidanceRate(
      digit
    );


  /*
    MULTI-WINDOW FREQUENCY
  */

  const averageFrequency =

    f50 * 0.40 +

    f100 * 0.25 +

    f250 * 0.20 +

    f500 * 0.15;


  /*
    MATCH SCORE

    Factors:

    - Recent frequency
    - Multi-window frequency
    - Current transition behaviour
    - Recent momentum
    - Historical next-10 repeat behaviour

    No Math.random().
  */

  const normalizedMomentum =
    Math.max(
      0,
      Math.min(
        (momentum + 0.10) / 0.20,
        1
      )
    );


  const matchScore =

    averageFrequency * 0.30 +

    transition * 0.25 +

    normalizedMomentum * 0.15 +

    repeatRate * 0.30;


  /*
    DIFFERS SCORE

    Factors favour:

    - Lower recent frequency
    - Lower transition probability
    - Historical next-10 avoidance
  */

  const differsScore =

    (1 - Math.min(
      averageFrequency * 5,
      1
    )) * 0.35 +

    (1 - Math.min(
      transition * 5,
      1
    )) * 0.30 +

    avoidanceRate * 0.35;


  return {

    digit,

    f50,

    f100,

    f250,

    f500,

    transition,

    drought:
      droughtValue,

    appearances:
      totalAppearances,

    momentum,

    repeatRate,

    avoidanceRate,

    matchScore,

    differsScore

  };

}


/* =========================================================
   MAIN ANALYSIS ENGINE
========================================================= */

function runStatisticalAnalysis() {

  const results = [];


  for (
    let digit = 0;
    digit <= 9;
    digit++
  ) {

    results.push(
      analyzeDigit(
        digit
      )
    );

  }


  /*
    MATCHES

    Prefer digits with meaningful
    historical appearances.
  */

  const validMatches =
    results.filter(
      item =>
        item.appearances >= 4
    );


  const matchesCandidates =
    validMatches.length
      ? validMatches
      : results;


  const matches =
    [...matchesCandidates]
      .sort(
        (a, b) =>
          b.matchScore -
          a.matchScore
      )[0];


  /*
    DIFFERS

    Select highest avoidance score.
  */

  const differs =
    [...results]
      .sort(
        (a, b) =>
          b.differsScore -
          a.differsScore
      )[0];


  displayMatches(
    matches
  );


  displayDiffers(
    differs
  );

}


/* =========================================================
   DISPLAY MATCHES
========================================================= */

function displayMatches(data) {

  document.getElementById(
    "matchesDigit"
  ).textContent =
    data.digit;


  document.getElementById(
    "matchesAppearances"
  ).textContent =
    data.appearances;


  document.getElementById(
    "matchesRate"
  ).textContent =
    (
      data.f50 * 100
    ).toFixed(1) + "%";


  document.getElementById(
    "matchesTransition"
  ).textContent =
    (
      data.transition * 100
    ).toFixed(1) + "%";


  document.getElementById(
    "matchesStatus"
  ).textContent =
    "STATISTICAL MATCH CANDIDATE";


  document.getElementById(
    "matchesReason"
  ).textContent =

    `Digit ${data.digit} ranked highest from real collected ticks using ` +

    `multi-window frequency, recent momentum, transition behaviour ` +

