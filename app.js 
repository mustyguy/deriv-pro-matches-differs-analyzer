  document.getElementById("progressFill");

const progressText =
  document.getElementById("progressText");

const dataQuality =
  document.getElementById("dataQuality");

const analysisWindow =
  document.getElementById("analysisWindow");

const symbolName =
  document.getElementById("symbolName");


/* =========================================================
   CONNECTION STATUS
========================================================= */

function setConnectionStatus(
  text,
  connected = false
) {

  if (!connectionStatus) return;

  connectionStatus.textContent =
    text;

  connectionStatus.className =
    connected
      ? "status connected"
      : "status disconnected";

}


/* =========================================================
   SAFE STATUS TEXT
========================================================= */

function setProgress(text) {

  if (progressText) {

    progressText.textContent =
      text;

  }

}


/* =========================================================
   CONNECT TO DERIV
========================================================= */

function connect() {

  if (isConnecting) {

    return;

  }


  isConnecting = true;


  clearTimeout(reconnectTimer);

  clearTimeout(connectionTimeout);

  clearTimeout(marketTimeout);


  /*
    Close old socket safely.
  */

  if (ws) {

    try {

      ws.onclose = null;

      ws.onerror = null;

      ws.close();

    } catch (error) {

      console.log(
        "Previous socket cleanup"
      );

    }

  }


  setConnectionStatus(
    "● CONNECTING",
    false
  );


  setProgress(
    "CONNECTING TO DERIV..."
  );


  console.log(
    "Connecting to:",
    WS_URL
  );


  try {

    ws = new WebSocket(
      WS_URL
    );

  } catch (error) {

    console.error(
      "WebSocket creation failed:",
      error
    );


    isConnecting = false;


    scheduleReconnect();

    return;

  }


  /* =====================================================
     CONNECTION TIMEOUT

     Prevents CONNECTING forever.
  ===================================================== */

  connectionTimeout =
    setTimeout(() => {

      if (
        ws &&
        ws.readyState !==
        WebSocket.OPEN
      ) {

        console.error(
          "Deriv connection timeout"
        );


        setConnectionStatus(
          "● CONNECTION TIMEOUT",
          false
        );


        setProgress(
          "CONNECTION TIMEOUT — RETRYING..."
        );


        try {

          ws.close();

        } catch (error) {

          console.log(
            "Socket timeout cleanup"
          );

        }

      }

    }, CONNECTION_TIMEOUT);


  /* =====================================================
     CONNECTION OPEN
  ===================================================== */

  ws.onopen = () => {

    clearTimeout(
      connectionTimeout
    );


    isConnecting = false;

    reconnectAttempts = 0;


    console.log(
      "CONNECTED TO DERIV"
    );


    setConnectionStatus(
      "● CONNECTED",
      true
    );


    setProgress(
      "CONNECTED — LOADING MARKETS..."
    );


    /*
      Ask Deriv for active symbols.
    */

    sendRequest({

  active_symbols: "brief",

  product_type: "basic",

  req_id: 1001

});


    /*
      If market data never arrives,
      show a useful message.
    */

    marketTimeout =
      setTimeout(() => {

        if (
          !activeSymbol
        ) {

          setProgress(
            "MARKET LIST DELAYED — RETRYING..."
          );


          console.warn(
            "Market list timeout"
          );


          if (
            ws &&
            ws.readyState ===
            WebSocket.OPEN
          ) {

            sendRequest({

  active_symbols: "brief",

  product_type: "basic",

  req_id: 1002

});

          }

        }

      }, MARKET_TIMEOUT);

  };


  /* =====================================================
     RECEIVE DERIV DATA
  ===================================================== */

  ws.onmessage = event => {

    let data;


    try {

      data =
        JSON.parse(
          event.data
        );

    } catch (error) {

      console.error(
        "Invalid JSON:",
        error
      );

      return;

    }


    console.log(
      "DERIV DATA:",
      data
    );


    /* =================================================
       API ERROR
    ================================================= */

    if (data.error) {

      console.error(
        "DERIV API ERROR:",
        data.error
      );


      setProgress(
        "API ERROR: " +
        (
          data.error.message ||
          "UNKNOWN ERROR"
        )
      );


      return;

    }


    /* =================================================
       ACTIVE SYMBOLS
    ================================================= */

    if (
      data.msg_type ===
      "active_symbols"
    ) {

      clearTimeout(
        marketTimeout
      );


      loadMarkets(
        data.active_symbols || []
      );


      return;

    }


    /* =================================================
       TICK HISTORY
    ================================================= */

    if (
      data.msg_type ===
      "history"
    ) {

      if (
        data.pip_size !== undefined &&
        data.pip_size !== null
      ) {

        activePipSize =
          Number(
            data.pip_size
          );

      }


      loadHistoricalTicks(
        data.history
      );


      setProgress(
        `${tickData.length} HISTORICAL TICKS LOADED — LIVE STREAM ACTIVE`
      );


      return;

    }


    /* =================================================
       LIVE TICK
    ================================================= */

    if (
      data.msg_type === "tick" &&
      data.tick
    ) {

      processLiveTick(
        data.tick
      );


      if (
        tickData.length >= 50
      ) {

        setProgress(
          "LIVE DATA READY FOR ANALYSIS"
        );

      }


      return;

    }

  };


  /* =====================================================
     WEBSOCKET ERROR
  ===================================================== */

  ws.onerror = error => {

    console.error(
      "WEBSOCKET ERROR:",
      error
    );


    setConnectionStatus(
      "● CONNECTION ERROR",
      false
    );


    setProgress(
      "WEBSOCKET ERROR — RECONNECTING..."
    );

  };


  /* =====================================================
     WEBSOCKET CLOSED
  ===================================================== */

  ws.onclose = event => {

    clearTimeout(
      connectionTimeout
    );


    clearTimeout(
      marketTimeout
    );


    isConnecting = false;


    console.log(
      "DERIV CONNECTION CLOSED:",
      event.code
    );


    setConnectionStatus(
      "● RECONNECTING",
      false
    );


    setProgress(
      "CONNECTION LOST — RECONNECTING..."
    );


    scheduleReconnect();

  };

}


/* =========================================================
   RECONNECT SYSTEM
========================================================= */

function scheduleReconnect() {

  clearTimeout(
    reconnectTimer
  );


  reconnectAttempts++;


  const delay =
    Math.min(

      3000 +
      reconnectAttempts * 1000,

      15000

    );


  reconnectTimer =
    setTimeout(
      connect,
      delay
    );

}


/* =========================================================
   SAFE SEND
========================================================= */

function sendRequest(request) {

  if (
    !ws ||
    ws.readyState !==
    WebSocket.OPEN
  ) {

    console.warn(
      "WebSocket not ready"
    );

    return false;

  }


  try {

    ws.send(
      JSON.stringify(
        request
      )
    );


    return true;

  } catch (error) {

    console.error(
      "Send error:",
      error
    );


    return false;

  }

}


/* =========================================================
   LOAD VOLATILITY MARKETS
========================================================= */

function loadMarkets(symbols) {

  console.log(
    "TOTAL SYMBOLS RECEIVED:",
    symbols.length
  );


  if (!symbols.length) {

    marketSelect.innerHTML =
      `<option value="">
        No markets received
      </option>`;


    setProgress(
      "NO MARKETS RECEIVED FROM DERIV"
    );


    return;

  }


  const markets =
    symbols

      .map(item => {

        const symbol =

          item.underlying_symbol ||

          item.symbol ||

          "";


        const name =

          item.underlying_symbol_name ||

          item.display_name ||

          symbol;


        const pipSize =

          item.pip_size ??

          item.pip ??

          null;


        const market =

          item.market ||

          "";


        return {

          symbol,

          name,

          pipSize,

          market

        };

      })


      /* ===============================================
         KEEP SYNTHETIC VOLATILITY MARKETS
      =============================================== */

      .filter(item => {

        const text =

          (
            item.name +
            " " +
            item.symbol +
            " " +
            item.market
          )
          .toLowerCase();


        return (

          text.includes(
            "volatility"
          ) ||

          item.symbol
            .toUpperCase()
            .includes("V")

        );

      })


      /* Remove empty symbols */

      .filter(item =>
        item.symbol
      )


      /* Remove duplicates */

      .filter(
        (
          item,
          index,
          array
        ) =>

          index ===
          array.findIndex(
            x =>
              x.symbol ===
              item.symbol
          )

      )


      /* Sort nicely */

      .sort(
        (a, b) =>
          a.name.localeCompare(
            b.name
          )
      );


  console.log(
    "VOLATILITY MARKETS:",
    markets
  );


  if (!markets.length) {

    marketSelect.innerHTML =
      `<option value="">
        No Volatility markets found
      </option>`;


    setProgress(
      "NO VOLATILITY MARKETS FOUND"
    );


    return;

  }


  /* ===============================================
     POPULATE DROPDOWN
  =============================================== */

  marketSelect.innerHTML =
    "";


  markets.forEach(
    market => {

      const option =
        document.createElement(
          "option"
        );


      option.value =
        market.symbol;


      option.textContent =
        market.name;


      option.dataset.pipSize =
        market.pipSize ?? "";


      marketSelect.appendChild(
        option
      );

    }
  );


  /* ===============================================
     SELECT FIRST MARKET
  =============================================== */

  const first =
    markets[0];


  activeSymbol =
    first.symbol;


  activePipSize =
    first.pipSize;


  symbolName.textContent =
    activeSymbol;


  console.log(
    "ACTIVE SYMBOL:",
    activeSymbol
  );


  resetMarketData();


  setProgress(
    `LOADING ${HISTORY_TICKS} HISTORICAL TICKS...`
  );


  /*
    Load historical data first.
  */

  requestHistoricalTicks();


  /*
    Start live tick stream.
  */

  subscribeToTicks();

}


