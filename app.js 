    "matchesReason"
  ).textContent =

    `Digit ${data.digit} was selected from real live ticks. ` +

    `It appeared ${data.count10} time(s) in the latest 10 ticks ` +

    `and ${data.appearances} time(s) in the collected dataset. ` +

    `Selection used recent frequency, multi-window frequency, ` +

    `recency weighting and transition analysis.`;

}


