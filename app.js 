/* =========================================================
   DIGITS PRO ANALYZER
   MATCHES & DIFFERS ONLY

   Public Deriv market-data connection
   No API token required
   No automatic trading
   No random digit selection
========================================================= */


/* =========================================================
   WEBSOCKET CONNECTION

   We try reliable public WebSocket endpoints.
========================================================= */

const WS_ENDPOINTS = [

  "wss://ws.binaryws.com/websockets/v3",

  "wss://ws.derivws.com/websockets/v3?app_id=1089"

];


let ws = null;

let endpointIndex = 0;

let reconnectTimer = null;

let reconnectAttempts = 0;


/* =========================================================
   MARKET + TICK STORAGE
========================================================= */

let activeSymbol = null;

let activePipSize = null;

let tickData = [];

const MAX_TICKS = 1000;

const HISTORY_TICKS = 500;


/* =========================================================
   DOM ELEMENTS
========================================================= */

const marketSelect =
  document.getElementById("marketSelect");

const connectionStatus =
  document.getElementById("connectionStatus");

const tickCount =
  document.getElementById("tickCount");

const latestDigit =
  document.getElementById("latestDigit");

const ticksElement =
  document.getElementById("ticks");

const frequencyGrid =
  document.getElementById("frequencyGrid");

const analyzeButton =
  document.getElementById("analyzeButton");

const progressFill =
  document.getElementById("progressFill");

const progressText =
  document.getElementById("progressText");

const dataQuality =
  document.getElementById("dataQuality");

const analysisWindow =
  document.getElementById("analysisWindow");

const symbolName =
  document.getElementById("symbolName");


/* =========================================================
   CONNECTION STATUS
========================================================= */

function setConnectionStatus(text, connected = false) {

  connectionStatus.textContent = text;

  connectionStatus.className =
    connected
      ? "status connected"
      : "status disconnected";

}


/* =========================================================
   CONNECT TO DERIV
========================================================= */

function connect() {

  clearTimeout(reconnectTimer);


  if (ws) {

    try {

      ws.onclose = null;

      ws.close();

    } catch (error) {

      console.log("Old socket closed");

    }

  }


  const endpoint =
    WS_ENDPOINTS[endpointIndex];


  setConnectionStatus(
    "● CONNECTING",
    false
  );


  console.log(
    "Connecting to:",
    endpoint
  );


  try {

    ws = new WebSocket(endpoint);

  } catch (error) {

    console.error(
      "WebSocket creation error:",
      error
    );

    tryNextEndpoint();

    return;

  }


  ws.onopen = () => {

    console.log(
      "Deriv WebSocket connected"
    );


    reconnectAttempts = 0;


    setConnectionStatus(
      "● CONNECTED",
      true
    );


    /*
      Get all currently active markets.
    */

    sendRequest({
      active_symbols: "brief",
      req_id: 1001
    });

  };


  ws.onmessage = event => {

    let data;


    try {

      data =
        JSON.parse(event.data);

    } catch (error) {

      console.error(
        "Invalid WebSocket message",
        error
      );

      return;

    }


    /*
      API ERROR
    */

    if (data.error) {

      console.error(
        "Deriv API error:",
        data.error.message
      );


      if (
        data.error.message
      ) {

        progressText.textContent =
          "API ERROR: " +
          data.error.message;

      }


      return;

    }


    /*
      ACTIVE SYMBOLS
    */

    if (
      data.msg_type ===
      "active_symbols"
    ) {

      loadMarkets(
        data.active_symbols || []
      );

      return;

    }


    /*
      TICK HISTORY
    */

    if (
      data.msg_type === "history"
    ) {

      loadHistoricalTicks(
        data.history
      );

      return;

    }


    /*
      LIVE TICK
    */

    if (
      data.msg_type === "tick" &&
      data.tick
    ) {

      processLiveTick(
        data.tick
      );

    }

  };


  ws.onerror = () => {

    console.error(
      "WebSocket connection error"
    );


    setConnectionStatus(
      "● CONNECTION ERROR",
      false
    );

  };


  ws.onclose = () => {

    console.log(
      "WebSocket closed"
    );


    setConnectionStatus(
      "● RECONNECTING",
      false
    );


    reconnectAttempts++;


    reconnectTimer =
      setTimeout(
        tryReconnect,
        2500
      );

  };

}


/* =========================================================
   TRY NEXT ENDPOINT
========================================================= */

function tryNextEndpoint() {

  endpointIndex =
    (
      endpointIndex + 1
    ) %
    WS_ENDPOINTS.length;


  setTimeout(
    connect,
    1000
  );

}


/* =========================================================
   RECONNECT
========================================================= */

function tryReconnect() {

  if (
    reconnectAttempts >= 3
  ) {

    endpointIndex =
      (
        endpointIndex + 1
      ) %
      WS_ENDPOINTS.length;

  }


  connect();

}


/* =========================================================
   SAFE SEND
========================================================= */

function sendRequest(request) {

  if (
    !ws ||
    ws.readyState !== WebSocket.OPEN
  ) {

    console.warn(
      "WebSocket not ready"
    );

    return false;

  }


  ws.send(
    JSON.stringify(request)
  );


  return true;

}


/* =========================================================
   LOAD VOLATILITY MARKETS

   Supports both older and newer
   Deriv active_symbols field names.
========================================================= */

function loadMarkets(symbols) {

  if (!symbols.length) {

    marketSelect.innerHTML =
      `<option value="">
        No markets received
      </option>`;

    progressText.textContent =
      "NO MARKETS RECEIVED";

    return;

  }


  const markets = symbols
    .map(item => {

      const symbol =
        item.symbol ||
        item.underlying_symbol ||
        "";


      const name =
        item.display_name ||
        item.underlying_symbol_name ||
        symbol;


      const pipSize =
        item.pip ??
        item.pip_size ??
        null;


      const market =
        item.market ||
        "";


      return {

        symbol,
        name,
        pipSize,
        market

      };

    })


    /*
      Only Volatility / Volatility 1s
      synthetic markets.
    */

    .filter(item => {

      const text =
        (
          item.name +
          " " +
          item.symbol +
          " " +
          item.market
        ).toLowerCase();


      return (
        text.includes("volatility") ||
        /^1hz/i.test(item.symbol) ||
        /^rz/i.test(item.symbol)
      );

    })


    /*
      Remove invalid/empty entries.
    */

    .filter(item =>
      item.symbol
    )


    /*
      Remove duplicates.
    */

    .filter(
      (
        item,
        index,
        array
      ) =>

        index ===
        array.findIndex(
          x =>
            x.symbol ===
            item.symbol
        )
    )


    /*
      Alphabetical order.
    */

    .sort(
      (a, b) =>
        a.name.localeCompare(
          b.name
        )
    );


  if (!markets.length) {

    console.warn(
      "No volatility markets found",
      symbols
    );


    marketSelect.innerHTML =
      `<option value="">
        No Volatility markets found
      </option>`;


    progressText.textContent =
      "MARKET LIST ERROR";


    return;

  }


  marketSelect.innerHTML = "";


  markets.forEach(market => {

    const option =
      document.createElement(
        "option"
      );


    option.value =
      market.symbol;


    option.textContent =
      market.name;


    option.dataset.pipSize =
      market.pipSize ?? "";


    marketSelect.appendChild(
      option
    );

  });


  /*
    Select first available market.
  */

  const first =
    markets[0];


  activeSymbol =
    first.symbol;


  activePipSize =
    first.pipSize;


  symbolName.textContent =
    activeSymbol;


  console.log(
    "Markets loaded:",
    markets.length
  );


  /*
    Get history immediately,
    then subscribe to live ticks.
  */

  resetMarketData();


  requestHistoricalTicks();


  subscribeToTicks();

}


/* =========================================================
   MARKET CHANGE
========================================================= */

marketSelect.addEventListener(
  "change",
  () => {

    const option =
      marketSelect.options[
        marketSelect.selectedIndex
      ];


    activeSymbol =
      option.value;


    activePipSize =
      option.dataset.pipSize
        ? Number(
            option.dataset.pipSize
          )
        : null;


    symbolName.textContent =
      activeSymbol;


    resetMarketData();


    requestHistoricalTicks();


    subscribeToTicks();

  }
);


/* =========================================================
   RESET MARKET DATA
========================================================= */

function resetMarketData() {

  tickData = [];


  latestDigit.textContent =
    "-";


  tickCount.textContent =
    "0";


  analysisWindow.textContent =
    "0 TICKS";


  ticksElement.textContent =
    "Loading market ticks...";


  frequencyGrid.innerHTML =
    "";


  dataQuality.textContent =
    "COLLECTING";


  resetResults();

}


/* =========================================================
   REQUEST HISTORICAL TICKS

   This means the analyzer does not
   have to wait a long time before
   collecting useful data.
========================================================= */

function requestHistoricalTicks() {

  if (!activeSymbol) {

    return;

  }


  sendRequest({

    ticks_history:
      activeSymbol,

    count:
      HISTORY_TICKS,

    end:
      "latest",

    style:
      "ticks",

    req_id:
      2001

  });

}


/* =========================================================
   SUBSCRIBE TO LIVE TICKS
========================================================= */

function subscribeToTicks() {

  if (!activeSymbol) {

    return;

  }


  sendRequest({

    ticks:
      activeSymbol,

    subscribe:
      1,

    req_id:
      2002

  });

}


/* =========================================================
   EXTRACT CORRECT LAST DIGIT

   Uses pip size when available so
   decimal trailing digits are handled
   more reliably.
========================================================= */

function extractLastDigit(
  quote,
  pipSize = activePipSize
) {

  if (
    quote === null ||
    quote === undefined
  ) {

    return null;

  }


  let quoteString;


  if (
    Number.isFinite(
      Number(pipSize)
    )
  ) {

    const decimals =
      Number(pipSize);


    quoteString =
      Number(quote).toFixed(
        decimals
      );

  }

  else {

    quoteString =
      String(quote);

  }


  const digits =
    quoteString.replace(
      /\D/g,
      ""
    );


  if (!digits.length) {

    return null;

  }


  return Number(
    digits[
      digits.length - 1
    ]
  );

}


/* =========================================================
   LOAD HISTORICAL DATA
========================================================= */

function loadHistoricalTicks(history) {

  if (!history) {

    return;

  }


  /*
    Different API versions can return
    arrays in different forms.
  */

  const prices =
    history.prices ||
    history.quotes ||
    [];


  const times =
    history.times ||
    [];


  if (!prices.length) {

    return;

  }


  tickData = [];


  prices.forEach(
    (price, index) => {

      const digit =
        extractLastDigit(
          price
        );


      if (
        digit === null
      ) {

        return;

      }


      tickData.push({

        digit,

        quote:
          price,

        epoch:
          times[index] ||
          Date.now()

      });

    }
  );


  /*
    Keep maximum storage.
  */

  if (
    tickData.length >
    MAX_TICKS
  ) {

    tickData =
      tickData.slice(
        -MAX_TICKS
      );

  }


  updateDashboard();


  console.log(
    "Historical ticks loaded:",
    tickData.length
  );

}


/* =========================================================
   PROCESS LIVE TICK
========================================================= */

function processLiveTick(tick) {

  /*
    Ignore ticks from another market.
  */

  if (
    activeSymbol &&
    tick.symbol &&
    tick.symbol !== activeSymbol
  ) {

    return;

  }


  /*
    Update pip size if Deriv supplies it.
  */

  if (
    tick.pip_size !== undefined
  ) {

    activePipSize =
      Number(
        tick.pip_size
      );

  }


  const digit =
    extractLastDigit(
      tick.quote,
      activePipSize
    );


  if (
    digit === null
  ) {

    return;

  }


  /*
    Avoid accidental duplicate tick.
  */

  const last =
    tickData[
      tickData.length - 1
    ];


  if (
    last &&
    last.epoch === tick.epoch &&
    last.quote === tick.quote
  ) {

    return;

  }


  tickData.push({

    digit,

    quote:
      tick.quote,

    epoch:
      tick.epoch

  });


  if (
    tickData.length >
    MAX_TICKS
  ) {

    tickData.shift();

  }


  updateDashboard();

}


/* =========================================================
   UPDATE DASHBOARD
========================================================= */

function updateDashboard() {

  tickCount.textContent =
    tickData.length;


  analysisWindow.textContent =
    `${tickData.length} TICKS`;


  if (
    tickData.length
  ) {

    latestDigit.textContent =
      tickData[
        tickData.length - 1
      ].digit;

  }


  updateTicks();

  updateFrequency();

  updateQuality();

}


/* =========================================================
   LIVE DIGIT DISPLAY
========================================================= */

function updateTicks() {

  if (!tickData.length) {

    ticksElement.textContent =
      "Waiting for live ticks...";

    return;

  }


  const latest =
    tickData
      .slice(-60)
      .reverse();


  ticksElement.innerHTML =
    latest.map(item =>

      `<div class="tick">
        ${item.digit}
      </div>`

    ).join("");

}


/* =========================================================
   FREQUENCY COUNTS
========================================================= */

function getCounts(data) {

  const counts =
    Array(10).fill(0);


  data.forEach(item => {

    if (
      item.digit >= 0 &&
      item.digit <= 9
    ) {

      counts[item.digit]++;

    }

  });


  return counts;

}


function updateFrequency() {

  const counts =
    getCounts(tickData);


  frequencyGrid.innerHTML =
    counts.map(
      (count, digit) =>

        `<div class="frequency-box">

          <div class="frequency-digit">
            ${digit}
          </div>

          <div class="frequency-count">
            ${count} TIMES
          </div>

        </div>`

    ).join("");

}


/* =========================================================
   DATA QUALITY
========================================================= */

function updateQuality() {

  const total =
    tickData.length;


  if (total < 50) {

    dataQuality.textContent =
      "LOW";

  }

  else if (total < 150) {

    dataQuality.textContent =
      "BUILDING";

  }

  else if (total < 300) {

    dataQuality.textContent =
      "GOOD";

  }

  else {

    dataQuality.textContent =
      "HIGH";

  }

}


