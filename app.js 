/* ==========================================
   DERIV CONNECTION
========================================== */

const DERIV_WS =
  "wss://ws.derivws.com/websockets/v3?app_id=1089";

let ws = null;

let activeSymbol = null;

let tickData = [];

const MAX_TICKS = 1000;

let reconnectTimer = null;

let currentSubscriptionId = null;


/* ==========================================
   DOM ELEMENTS
========================================== */

const marketSelect =
  document.getElementById("marketSelect");

const connectionStatus =
  document.getElementById("connectionStatus");

const tickCount =
  document.getElementById("tickCount");

const latestDigit =
  document.getElementById("latestDigit");

const ticksElement =
  document.getElementById("ticks");

const frequencyGrid =
  document.getElementById("frequencyGrid");

const analyzeButton =
  document.getElementById("analyzeButton");

const progressFill =
  document.getElementById("progressFill");

const progressText =
  document.getElementById("progressText");

const dataQuality =
  document.getElementById("dataQuality");

const analysisWindow =
  document.getElementById("analysisWindow");

const symbolName =
  document.getElementById("symbolName");


/* ==========================================
   CONNECT TO DERIV
========================================== */

function connect() {

  clearTimeout(reconnectTimer);


  if (ws) {

    try {

      ws.onclose = null;

      ws.close();

    } catch (error) {

      console.error(error);

    }

  }


  connectionStatus.textContent =
    "● CONNECTING";

  connectionStatus.className =
    "status disconnected";


  ws = new WebSocket(DERIV_WS);


  ws.onopen = () => {

    connectionStatus.textContent =
      "● CONNECTED";

    connectionStatus.className =
      "status connected";


    ws.send(
      JSON.stringify({
        active_symbols: "brief"
      })
    );

  };


  ws.onmessage = event => {

    let data;


    try {

      data =
        JSON.parse(event.data);

    } catch (error) {

      console.error(
        "Invalid Deriv message",
        error
      );

      return;

    }


    if (data.error) {

      console.error(
        "DERIV ERROR:",
        data.error.message
      );

      progressText.textContent =
        "DERIV ERROR: " +
        data.error.message;

      return;

    }


    if (
      data.msg_type ===
      "active_symbols"
    ) {

      loadVolatilityMarkets(
        data.active_symbols
      );

      return;

    }


    if (
      data.msg_type === "tick" &&
      data.tick
    ) {

      processTick(
        data.tick
      );

      return;

    }


    if (
      data.msg_type ===
      "forget_all"
    ) {

      return;

    }

  };


  ws.onerror = () => {

    connectionStatus.textContent =
      "● CONNECTION ERROR";

    connectionStatus.className =
      "status disconnected";

  };


  ws.onclose = () => {

    connectionStatus.textContent =
      "● RECONNECTING";

    connectionStatus.className =
      "status disconnected";


    clearTimeout(reconnectTimer);


    reconnectTimer =
      setTimeout(
        connect,
        3000
      );

  };

}


connect();


/* ==========================================
   LOAD REAL DERIV VOLATILITY MARKETS
========================================== */

function loadVolatilityMarkets(symbols) {

  const volatilityMarkets =
    symbols
      .filter(market => {

        const name =
          String(
            market.display_name || ""
          ).toLowerCase();


        const symbol =
          String(
            market.symbol || ""
          ).toLowerCase();


        const text =
          name + " " + symbol;


        return (
          text.includes("volatility")
        );

      })


      .sort((a, b) => {

        return a.display_name.localeCompare(
          b.display_name
        );

      });


  marketSelect.innerHTML = "";


  if (
    volatilityMarkets.length === 0
  ) {

    const option =
      document.createElement("option");


    option.value = "";

    option.textContent =
      "No Volatility markets found";


    marketSelect.appendChild(option);


    progressText.textContent =
      "NO VOLATILITY MARKETS RECEIVED";

    return;

  }


  volatilityMarkets.forEach(
    market => {

      const option =
        document.createElement("option");


      option.value =
        market.symbol;


      option.textContent =
        market.display_name;


      marketSelect.appendChild(
        option
      );

    }
  );


  activeSymbol =
    volatilityMarkets[0].symbol;


  marketSelect.value =
    activeSymbol;


  symbolName.textContent =
    activeSymbol;


  subscribeToTicks();

}


/* ==========================================
   CHANGE MARKET

   Old market data is deleted so that
   different volatility indices are never mixed.
========================================== */

marketSelect.addEventListener(
  "change",
  () => {

    activeSymbol =
      marketSelect.value;


    if (!activeSymbol) {

      return;

    }


    symbolName.textContent =
      activeSymbol;


    tickData = [];


    currentSubscriptionId = null;


    resetResults();


    updateDashboard();


    progressFill.style.width =
      "0%";


    progressText.textContent =
      "COLLECTING NEW MARKET DATA";


    subscribeToTicks();

  }
);


/* ==========================================
   SUBSCRIBE TO LIVE TICKS
========================================== */

function subscribeToTicks() {

  if (
    !ws ||
    ws.readyState !==
      WebSocket.OPEN ||
    !activeSymbol
  ) {

    return;

  }


  ws.send(
    JSON.stringify({
      forget_all: "ticks"
    })
  );


  setTimeout(() => {

    if (
      !ws ||
      ws.readyState !==
        WebSocket.OPEN
    ) {

      return;

    }


    ws.send(
      JSON.stringify({
        ticks: activeSymbol,
        subscribe: 1
      })
    );

  }, 500);

}


/* ==========================================
   GET THE CORRECT LAST DIGIT

   IMPORTANT:

   Using String(tick.quote) alone can remove
   trailing decimal zeros.

   pip_size is used to preserve the displayed
   quote precision before extracting the digit.
========================================== */

function getLastDigit(tick) {

  const quote =
    Number(tick.quote);


  const pipSize =
    Number.isInteger(tick.pip_size)
      ? tick.pip_size
      : 2;


  const formattedQuote =
    quote.toFixed(pipSize);


  const digitsOnly =
    formattedQuote.replace(
      /\D/g,
      ""
    );


  if (!digitsOnly.length) {

    return null;

  }


  return Number(
    digitsOnly[
      digitsOnly.length - 1
    ]
  );

}


/* ==========================================
   PROCESS LIVE TICK
========================================== */

function processTick(tick) {

  const digit =
    getLastDigit(tick);


  if (
    digit === null ||
    digit < 0 ||
    digit > 9
  ) {

    return;

  }


  tickData.push({

    digit: digit,

    epoch: tick.epoch,

    quote: tick.quote,

    pip_size: tick.pip_size

  });


  if (
    tickData.length >
    MAX_TICKS
  ) {

    tickData.shift();

  }


  updateDashboard();

}


/* ==========================================
   UPDATE DASHBOARD
========================================== */

function updateDashboard() {

  tickCount.textContent =
    tickData.length;


  analysisWindow.textContent =
    `${tickData.length} TICKS`;


  if (
    tickData.length > 0
  ) {

    latestDigit.textContent =
      tickData[
        tickData.length - 1
      ].digit;

  } else {

    latestDigit.textContent =
      "-";

  }


  updateTicks();

  updateFrequency();

  updateQuality();

}


/* ==========================================
   DISPLAY LATEST LIVE DIGITS
========================================== */

function updateTicks() {

  if (
    tickData.length === 0
  ) {

    ticksElement.textContent =
      "Waiting for live ticks...";

    return;

  }


  const latest =
    tickData
      .slice(-60)
      .reverse();


  ticksElement.innerHTML =
    latest.map(item => {

      return `
        <div class="tick">
          ${item.digit}
        </div>
      `;

    }).join("");

}


/* ==========================================
   COUNT DIGITS
========================================== */

function getCounts(data) {

  const counts =
    Array(10).fill(0);


  data.forEach(item => {

    if (
      item.digit >= 0 &&
      item.digit <= 9
    ) {

      counts[item.digit]++;

    }

  });


  return counts;

}


/* ==========================================
   DISPLAY FREQUENCY
========================================== */

function updateFrequency() {

  const counts =
    getCounts(tickData);


  frequencyGrid.innerHTML =
    counts.map(
      (count, digit) => {

        return `
          <div class="frequency-box">

            <div class="frequency-digit">
              ${digit}
            </div>

            <div class="frequency-count">
              ${count} TIMES
            </div>

          </div>
        `;

      }
    ).join("");

}


/* ==========================================
   DATA QUALITY
========================================== */

function updateQuality() {

  const total =
    tickData.length;


  if (total < 30) {

    dataQuality.textContent =
      "LOW";

  }

  else if (total < 100) {

    dataQuality.textContent =
      "BUILDING";

  }

  else if (total < 300) {

    dataQuality.textContent =
      "GOOD";

  }

  else if (total < 500) {

    dataQuality.textContent =
      "HIGH";

  }

  else {

    dataQuality.textContent =
      "VERY HIGH";

  }

}


