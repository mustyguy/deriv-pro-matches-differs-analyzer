  ).textContent =
    data.appearances;


  document.getElementById(
    "matchesRate"
  ).textContent =
    (
      data.f10 * 100
    ).toFixed(1) + "%";


  document.getElementById(
    "matchesTransition"
  ).textContent =
    (
      data.transition * 100
    ).toFixed(1) + "%";


  document.getElementById(
    "matchesStatus"
  ).textContent =
    "REAL-DATA SELECTED";


