 /* =========================================
   DIGITS PRO ANALYZER - STYLE
========================================= */

* {
  box-sizing: border-box;
}

html {
  background: #080b10;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Arial, sans-serif;
  background: #080b10;
  color: #ffffff;
}


/* =========================================
   MAIN APP
========================================= */

.app {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 15px;
}


/* =========================================
   HEADER
========================================= */

header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 20px;

  background: #0d1117;
  border: 1px solid #26313d;
  border-radius: 10px;

  margin-bottom: 15px;
}

h1 {
  margin: 0;
  font-size: 24px;
}

header p {
  margin: 6px 0 0;
  color: #8b949e;
  font-size: 12px;
}

.status {
  font-weight: bold;
  font-size: 13px;
  margin-top: 10px;
}

.connected {
  color: #00e676;
}

.disconnected {
  color: #ff5252;
}


/* =========================================
   PANELS
========================================= */

.panel {
  background: #0d1117;

  border: 1px solid #26313d;
  border-radius: 10px;

  padding: 18px;

  margin-bottom: 15px;
}

.panel h2 {
  margin: 0 0 15px;
  font-size: 15px;
}


/* =========================================
   MARKET SELECT
========================================= */

select {
  width: 100%;

  padding: 14px;

  background: #161b22;
  color: #ffffff;

  border: 1px solid #30363d;
  border-radius: 6px;

  font-size: 15px;
}


/* =========================================
   MARKET INFORMATION
========================================= */

.market-info {
  display: grid;
  grid-template-columns: repeat(3, 1fr);

  gap: 10px;

  margin-top: 15px;
}

.market-info div {
  background: #161b22;

  border: 1px solid #26313d;
  border-radius: 6px;

  padding: 12px;
}

.market-info span {
  display: block;

  font-size: 10px;
  color: #8b949e;
}

.market-info strong {
  display: block;

  margin-top: 6px;

  font-size: 18px;
}


/* =========================================
   LIVE TICKS
========================================= */

.ticks {
  display: flex;
  flex-wrap: wrap;

  gap: 7px;

  min-height: 50px;
}

.tick {
  width: 38px;
  height: 38px;

  display: flex;
  justify-content: center;
  align-items: center;

  background: #161b22;

  border: 1px solid #30363d;
  border-radius: 6px;

  font-size: 18px;
  font-weight: bold;
}


/* =========================================
   DESCRIPTION
========================================= */

.description {
  color: #8b949e;
  font-size: 13px;
  line-height: 1.5;
}


/* =========================================
   ANALYZE BUTTON
========================================= */

.analyze-button {
  width: 100%;

  padding: 18px;

  margin-top: 15px;

  border: none;
  border-radius: 8px;

  background: #00c853;
  color: #000000;

  font-size: 15px;
  font-weight: bold;

  cursor: pointer;
}

.analyze-button:active {
  transform: scale(0.99);
}

.analyze-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}


/* =========================================
   PROGRESS BAR
========================================= */

.progress-container {
  margin-top: 20px;
}

.progress-bar {
  width: 100%;
  height: 20px;

  overflow: hidden;

  background: #161b22;

  border: 1px solid #30363d;
  border-radius: 10px;
}

.progress-fill {
  width: 0%;
  height: 100%;

  background: #00e676;

  transition: width 0.05s linear;
}

.progress-text {
  text-align: center;

  margin-top: 8px;

  font-size: 13px;
  font-weight: bold;

  color: #00e676;
}


/* =========================================
   RESULTS GRID
========================================= */

.results-grid {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 15px;

  margin-bottom: 15px;
}

.result-card {
  background: #0d1117;

  padding: 20px;

  border: 1px solid #26313d;
  border-radius: 10px;
}

.result-card h2 {
  margin-top: 0;
}

.matches {
  border-top: 4px solid #00e676;
}

.differs {
  border-top: 4px solid #ff9800;
}


/* =========================================
   RESULT DIGIT
========================================= */

.result-digit {
  font-size: 100px;
  font-weight: bold;

  text-align: center;

  margin: 15px 0;
}

.result-status {
  text-align: center;

  font-size: 13px;
  font-weight: bold;

  margin-bottom: 15px;
}

.result-card p {
  color: #a8b0b9;

  min-height: 60px;

  font-size: 13px;
  line-height: 1.5;
}


/* =========================================
   RESULT STATISTICS
========================================= */

.stats {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 7px;
}

.stats div {
  background: #161b22;

  border: 1px solid #26313d;
  border-radius: 6px;

  padding: 10px;
}

.stats span {
  display: block;

  font-size: 9px;

  color: #8b949e;
}

.stats strong {
  display: block;

  margin-top: 5px;

  font-size: 13px;
}


/* =========================================
   FREQUENCY GRID
========================================= */

.frequency-grid {
  display: grid;

  grid-template-columns: repeat(10, 1fr);

  gap: 7px;
}

.frequency-box {
  text-align: center;

  background: #161b22;

  border: 1px solid #30363d;
  border-radius: 6px;

  padding: 12px 5px;
}

.frequency-digit {
  font-size: 22px;
  font-weight: bold;
}

.frequency-count {
  margin-top: 5px;

  color: #8b949e;

  font-size: 11px;
}


/* =========================================
   DATA QUALITY
========================================= */

.quality {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 10px;
}

.quality div {
  background: #161b22;

  border: 1px solid #26313d;
  border-radius: 6px;

  padding: 12px;
}

.quality span {
  display: block;

  font-size: 10px;

  color: #8b949e;
}

.quality strong {
  display: block;

  margin-top: 5px;

  font-size: 14px;
}


/* =========================================
   MOBILE RESPONSIVE DESIGN
========================================= */

@media (max-width: 700px) {

  .app {
    padding: 10px;
  }

  header {
    flex-direction: column;
    align-items: flex-start;

    padding: 15px;
  }

  h1 {
    font-size: 20px;
  }

  .market-info {
    grid-template-columns: 1fr;
  }

  .results-grid {
    grid-template-columns: 1fr;
  }

  .frequency-grid {
    grid-template-columns: repeat(5, 1fr);
  }

  .quality {
    grid-template-columns: 1fr;
  }

  .result-digit {
    font-size: 80px;
  }

  .stats {
    grid-template-columns: 1fr;
  }

}